#include<stdio.h>
void main()
{
    int blocks=3;
    int lines=4;
    int stars=5;
    int a;
    int tot=0;
    for(int i=0;i<blocks;i++)
        {
            a=0;
            for(int j=0;j<lines-i;j++)
                {
                    for(int k=0;k<stars;k++)
                        {
                            printf("* ");
                            a++;
                            tot++;
                        }
                    printf("\n");
                }
            printf("_________\n");
            printf("total in this block is %d\n",a);
        }
    printf("%d",tot);
}
